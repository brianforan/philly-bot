# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel IDs are NOT set here. Invite the bot with Manage Channels, then run /setup in your
# server; the bot creates its channels and stores their IDs in the SQLite DB.

# Anthropic API key: event classification, relevance filter, major-event discovery, /ask.
# Without it the LLM steps fail soft (items pass through unclassified).
ANTHROPIC_API_KEY=

# Ticketmaster Discovery API key from https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_key_here

# Google Maps Geocoding API key from https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Optional: PennDOT RCRS Event Data credentials (HTTP Basic auth), issued via PennDOT's
# Data Feed Request Form. Used by the #traffic-alerts channel (penndot.py) and the terminal
# preview tools/penndot_rcrs.py. Without them the channel is never created.
PENNDOT_RCRS_USERNAME=
PENNDOT_RCRS_PASSWORD=

# Required: the center point for distance labels and near-home filters. Keep your real
# location here, not in code. CENTER_NAME is what users see ("0.6 mi from <CENTER_NAME>").
# The example below is City Hall.
CENTER_NAME=City Hall
CENTER_LAT=39.9526
CENTER_LON=-75.1652

# Optional: SQLite path. Defaults to philly_bot.db; docker-compose sets /data/philly_bot.db.
# DB_PATH=philly_bot.db
